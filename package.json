{
  "name": "solana-risk-engine",
  "version": "0.4.3",
  "description": "Explainable risk analysis for Solana tokens and wallets: creator control, real holder concentration, inflated liquidity, impostor tokens, funder clusters and PnL. Zero dependencies, runs in Node and the browser.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./i18n": "./src/i18n/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "bin"
  ],
  "bin": {
    "solana-risk": "bin/solana-risk.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "example": "node bin/solana-risk.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "solana",
    "risk",
    "rug-pull",
    "scam-detection",
    "token",
    "spl-token",
    "token-2022",
    "holders",
    "dexscreener",
    "rugcheck"
  ],
